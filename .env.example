# LLM Provider: 'gemini', 'openai', 'ollama', or 'rule_based' (default)
LLM_PROVIDER=rule_based

# Gemini API (get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Security
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRY_HOURS=24

# App
FLASK_DEBUG=false
PORT=5000
