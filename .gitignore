# Environment variables & secrets (CRITICAL: NEVER COMMIT API KEYS)
.env
.env.local
.env.*.local
*.env
!.env.example

# Python virtual environments & bytecode
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# SQLite databases & temp locks
*.db
*.sqlite3
*.db-wal
*.db-shm

# Frontend node_modules & development build caches
frontend/node_modules/
node_modules/
frontend/dist/
.eslintcache

# Generated dynamic PDFs (keep folder via .gitkeep)
static/pdfs/*.pdf
!static/pdfs/.gitkeep

# IDE & Operating System artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
